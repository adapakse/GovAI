# Bez DOMAIN_NAME (self-signed, on_demand) — nowoczesny Caddy usunął proste
# rate-limity (interval/burst) z on_demand_tls, jedyna wbudowana ochrona to
# endpoint `ask`. Dla środowisk bez ustalonej domeny nie ma z góry listy
# dozwolonych SNI do zweryfikowania w `ask`, więc świadomie tego pomijamy —
# ryzyko (ktoś wymusza generowanie certów losowym SNI) ogranicz na poziomie
# sieci (NSG/firewall), nie tutaj. Realne wdrożenia klienckie zawsze mają
# DOMAIN_NAME ustawiony i idą przez Caddyfile.domain.template (zwykłe ACME,
# ten problem tam nie występuje).
:443 {
	tls internal {
		on_demand
	}
	encode gzip

	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle_path /gateway/* {
		reverse_proxy gateway:8001
	}

	handle {
		reverse_proxy frontend:3000
	}
}
