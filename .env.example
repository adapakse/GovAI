ANTHROPIC_API_KEY=sk-ant-...
DB_PASSWORD=govai_secret
LOG_LEVEL=INFO
JWT_SECRET=wygeneruj-przez-python-c-import-secrets-print-secrets-token-hex-32
# CORS — domena(y) konsoli, oddzielone przecinkiem. Konsola (frontend/api/gateway)
# żyje na subdomenie app.<DOMAIN_NAME>, nie na root domenie — patrz DOMAIN_NAME niżej.
# Prod: https://app.govai.pl (nie https://govai.pl — to strona marketingowa, inny host).
ALLOWED_ORIGINS=https://localhost
# Domena publiczna (Caddy) — ustaw dla realnego wdrożenia, np. DOMAIN_NAME=govai.pl.
# Root domeny (govai.pl) serwuje statyczną stronę marketingową z website/ (landing + blog).
# Konsola/produkt (frontend, /api, /gateway) automatycznie ląduje na app.govai.pl —
# świadomy split, żeby landing i panel logowania nigdy nie dzieliły jednego hosta/canonical URL.
# Wymaga w DNS dwóch rekordów A/AAAA na tę VM: govai.pl i app.govai.pl (albo wildcard *.govai.pl).
# Bez DOMAIN_NAME Caddy nasłuchuje na :443 z samopodpisanym certyfikatem (OK dla lokalnego dev/INT).
DOMAIN_NAME=
